@model WEBDEV_Project.Models.Claim
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Claim Messages";
    var userId = UserManager.GetUserId(User);
    var isPoster = Model.Item!.UserId == userId;
}

<div class="row justify-content-center animate-fade-in-up">
    <div class="col-lg-8">
        <div class="glass-panel mb-4 p-0 overflow-hidden d-flex flex-column" style="height: 70vh; min-height: 500px;">
            <div class="p-3 p-md-4 border-bottom border-light bg-dark bg-opacity-50 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary));">
                        <i class="fas fa-comments fs-5 text-white"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-white mb-0" style="font-family: var(--font-heading);">Message Thread</h5>
                        <p class="text-secondary small mb-0">Claim regarding: <strong><a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="text-primary text-decoration-none hover-glow">@Model.Item.Title</a></strong></p>
                    </div>
                </div>
                <span class="badge bg-@(Model.Status == WEBDEV_Project.Models.ClaimStatus.Pending ? "warning" : Model.Status == WEBDEV_Project.Models.ClaimStatus.Approved ? "success" : "danger") bg-opacity-25 border border-@(Model.Status == WEBDEV_Project.Models.ClaimStatus.Pending ? "warning" : Model.Status == WEBDEV_Project.Models.ClaimStatus.Approved ? "success" : "danger") border-opacity-25 text-@(Model.Status == WEBDEV_Project.Models.ClaimStatus.Pending ? "warning" : Model.Status == WEBDEV_Project.Models.ClaimStatus.Approved ? "success" : "danger") fs-6 px-3 py-2 rounded-pill shadow-sm">
                    @Model.Status.ToString().ToUpper()
                </span>
            </div>
            
            <div class="p-3 p-md-4 flex-grow-1" style="overflow-y: auto;" id="messageContainer">
                @if (!Model.Messages.Any())
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                            <i class="far fa-comment-dots fa-3x text-secondary opacity-50"></i>
                        </div>
                        <p class="text-secondary fw-medium">No messages yet. Send a message to start the conversation.</p>
                    </div>
                }
                else
                {
                    <div class="mb-4 text-center">
                        <span class="badge bg-dark bg-opacity-50 text-secondary border border-light rounded-pill px-3 py-2">Claim Submitted: @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var msg in Model.Messages)
                        {
                            var isMine = msg.SenderId == userId;
                            <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start")">
                                <div class="p-3 rounded-4 shadow-sm position-relative" style="max-width: 75%; background: @(isMine ? "linear-gradient(135deg, var(--accent-secondary), var(--accent-primary))" : "rgba(255,255,255,0.05)"); border: 1px solid @(isMine ? "transparent" : "rgba(255,255,255,0.1)"); border-bottom-right-radius: @(isMine ? "4px" : "16px") !important; border-bottom-left-radius: @(!isMine ? "4px" : "16px") !important;">
                                    @if (!isMine)
                                    {
                                        <div class="fw-bold small mb-1" style="color: var(--accent-secondary);">@msg.Sender?.DisplayName</div>
                                    }
                                    <div class="text-white fs-6 lh-base" style="white-space: pre-wrap; word-break: break-word;">@msg.Body</div>
                                    <div class="text-end mt-2 d-flex align-items-center justify-content-end gap-1" style="font-size: 0.7rem; color: rgba(255,255,255,0.7);">
                                        @msg.SentAt.ToLocalTime().ToString("hh:mm tt")
                                        @if (isMine)
                                        {
                                            <i class="fas @(msg.IsRead ? "fa-check-double text-info" : "fa-check")"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (Model.Status != WEBDEV_Project.Models.ClaimStatus.Rejected)
            {
                <div class="p-3 bg-dark bg-opacity-50 border-top border-light">
                    <form asp-action="Send" method="post">
                        <input type="hidden" name="claimId" value="@Model.Id" />
                        <div class="input-group align-items-end p-1 rounded-4 bg-dark border border-light">
                            <textarea name="body" class="form-control bg-transparent border-0 text-white shadow-none" rows="1" style="resize: none; max-height: 120px;" placeholder="Type your message..." required oninput="this.style.height = ''; this.style.height = Math.min(this.scrollHeight, 120) + 'px'"></textarea>
                            <button type="submit" class="btn btn-primary rounded-circle m-1 d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 40px; height: 40px; transition: all 0.2s ease;">
                                <i class="fas fa-paper-plane ms-n1"></i>
                            </button>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="p-3 bg-danger bg-opacity-10 border-top border-danger border-opacity-25 text-center">
                    <span class="text-danger fw-bold"><i class="fas fa-lock me-2"></i>This claim has been rejected. Messaging is disabled.</span>
                </div>
            }
        </div>

        @if (isPoster && Model.Status == WEBDEV_Project.Models.ClaimStatus.Pending)
        {
            <div class="glass-panel border-warning border-opacity-50 bg-warning bg-opacity-10 p-0 overflow-hidden mb-4">
                <div class="p-4 p-md-5 text-center position-relative">
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at center, rgba(245, 158, 11, 0.1), transparent); pointer-events: none;"></div>
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-lg" style="width: 64px; height: 64px; background: rgba(245, 158, 11, 0.2); border: 2px solid rgba(245, 158, 11, 0.5);">
                        <i class="fas fa-gavel fa-2x text-warning"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-2" style="font-family: var(--font-heading);">Owner Actions</h4>
                    <p class="text-secondary mb-4 fs-6">Are you satisfied that this person is the true owner / finder of the item?</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <form asp-controller="Claims" asp-action="Approve" method="post" onsubmit="return confirm('Approve this claim? This will share your contact info or arrange handover.');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success px-4 py-2 fw-semibold d-flex align-items-center"><i class="fas fa-check me-2"></i>Approve Claim</button>
                        </form>
                        <form asp-controller="Claims" asp-action="Reject" method="post" onsubmit="return confirm('Reject this claim permanently?');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger px-4 py-2 fw-semibold d-flex align-items-center"><i class="fas fa-times me-2"></i>Reject Claim</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else if (Model.Status == WEBDEV_Project.Models.ClaimStatus.Approved)
        {
            var myConfirmation = isPoster ? Model.PosterConfirmed : Model.ClaimantConfirmed;
            var otherConfirmation = isPoster ? Model.ClaimantConfirmed : Model.PosterConfirmed;
            
            <div class="glass-panel border-success border-opacity-50 bg-success bg-opacity-10 p-0 overflow-hidden mb-4">
                <div class="p-4 p-md-5 text-center position-relative">
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at center, rgba(16, 185, 129, 0.1), transparent); pointer-events: none;"></div>
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-lg" style="width: 64px; height: 64px; background: rgba(16, 185, 129, 0.2); border: 2px solid rgba(16, 185, 129, 0.5);">
                        <i class="fas fa-handshake fa-2x text-success"></i>
                    </div>
                    <h4 class="fw-bold text-success mb-2" style="font-family: var(--font-heading);">Claim Approved</h4>
                    <p class="text-white-50 mb-4 fs-6">The claim has been approved. Please arrange a time and place to hand over the item.</p>
                    
                    @if (!myConfirmation)
                    {
                        <form asp-controller="Claims" asp-action="ConfirmHandover" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success px-5 py-3 fw-bold fs-5 shadow-lg d-flex align-items-center justify-content-center mx-auto" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                                <i class="fas fa-check-circle me-2"></i>I Confirm Item Handover
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="d-inline-flex flex-column align-items-center bg-dark bg-opacity-25 border border-success border-opacity-25 rounded-4 p-4">
                            <div class="d-flex align-items-center text-success fw-bold fs-5 mb-2">
                                <i class="fas fa-check-circle me-2"></i>You confirmed the handover.
                            </div>
                            @if (!otherConfirmation)
                            {
                                <div class="text-secondary small d-flex align-items-center mt-2">
                                    <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                                    Waiting for the other party to confirm...
                                </div>
                            }
                            else
                            {
                                <div class="text-success small fw-medium mt-2">
                                    Both parties have confirmed!
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var container = $('#messageContainer');
            container.scrollTop(container[0].scrollHeight);
        });
    </script>
}
