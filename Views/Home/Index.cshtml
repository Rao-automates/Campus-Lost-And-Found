@model IEnumerable<WEBDEV_Project.Models.Item>
@{
    ViewData["Title"] = "Home Page";
    var announcement = ViewBag.Announcement as WEBDEV_Project.Models.Announcement;
}

@if (announcement != null)
{
    <div class="glass-panel animate-fade-in-up mb-4" style="border-left: 4px solid var(--accent-primary);">
        <div class="d-flex align-items-center p-3 p-md-4">
            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 me-md-4" style="width: 48px; height: 48px; background: rgba(139, 92, 246, 0.15);">
                <i class="fas fa-bullhorn fa-lg text-primary"></i>
            </div>
            <div>
                <h5 class="mb-1 fw-bold text-white">Campus Announcement</h5>
                <p class="mb-0 text-white opacity-75">@announcement.Message</p>
            </div>
        </div>
    </div>
}

<div class="p-5 mb-5 glass-panel position-relative overflow-hidden text-center animate-fade-in-up delay-100" style="border: 1px solid var(--border-highlight); box-shadow: 0 0 40px rgba(139, 92, 246, 0.1);">
    <div class="position-absolute top-0 start-50 translate-middle" style="width: 600px; height: 600px; background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, transparent 70%); z-index: 0; pointer-events: none;"></div>
    
    <div class="container-fluid py-5 position-relative" z-index="1">
        <h1 class="display-3 fw-bold mb-3 text-white" style="font-family: var(--font-heading); letter-spacing: -0.05em;">
            Campus <span class="text-gradient">Lost & Found</span>
        </h1>
        <p class="fs-5 text-secondary mx-auto mb-5" style="max-width: 600px;">
            A community-driven platform to help students and staff recover lost items and report found belongings across the campus.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Items" asp-action="Create" class="btn btn-primary btn-lg px-4 py-3 rounded-pill fs-6">
                <i class="fas fa-plus me-2"></i>Post an Item
            </a>
            <a asp-controller="Items" asp-action="Index" class="btn btn-outline-primary btn-lg px-4 py-3 rounded-pill fs-6">
                <i class="fas fa-search me-2"></i>Browse Items
            </a>
        </div>
    </div>
</div>

<div class="row text-center mb-5 animate-fade-in-up delay-200">
    <div class="col-md-4 mb-4 mb-md-0">
        <div class="glass-panel interactive h-100 py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(139, 92, 246, 0.1);">
                <i class="fas fa-box-open fa-2x" style="color: var(--accent-primary);"></i>
            </div>
            <h2 class="fw-bold mb-1 display-5 text-white">@ViewBag.TotalItems</h2>
            <p class="text-secondary fw-medium mb-0 text-uppercase tracking-wider" style="font-size: 0.85rem; letter-spacing: 0.05em;">Total Items</p>
        </div>
    </div>
    <div class="col-md-4 mb-4 mb-md-0">
        <div class="glass-panel interactive h-100 py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(16, 185, 129, 0.1);">
                <i class="fas fa-handshake fa-2x text-success"></i>
            </div>
            <h2 class="fw-bold mb-1 display-5 text-white">@ViewBag.ResolvedItems</h2>
            <p class="text-secondary fw-medium mb-0 text-uppercase tracking-wider" style="font-size: 0.85rem; letter-spacing: 0.05em;">Items Reunited</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-panel interactive h-100 py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(245, 158, 11, 0.1);">
                <i class="fas fa-tags fa-2x text-warning"></i>
            </div>
            <h2 class="fw-bold mb-1 display-5 text-white">@ViewBag.TotalCategories</h2>
            <p class="text-secondary fw-medium mb-0 text-uppercase tracking-wider" style="font-size: 0.85rem; letter-spacing: 0.05em;">Categories</p>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-light pb-3 animate-fade-in-up delay-300">
    <h3 class="fw-bold mb-0 text-white" style="font-family: var(--font-heading);">Recently Posted</h3>
    <a asp-controller="Items" asp-action="Index" class="text-decoration-none text-gradient fw-semibold">View All <i class="fas fa-arrow-right ms-1"></i></a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 animate-fade-in-up delay-400">
    @foreach (var item in Model)
    {
        var badgeClass = item.Type == WEBDEV_Project.Models.ItemType.Lost ? "badge-lost" : "badge-found";
        <div class="col">
            <div class="glass-panel interactive h-100 d-flex flex-column overflow-hidden p-0">
                <div class="position-relative">
                    @if (item.Images.Any(i => i.IsPrimary))
                    {
                        <img src="@item.Images.First(i => i.IsPrimary).Path" class="w-100" alt="Item Image" style="height: 220px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="w-100 d-flex align-items-center justify-content-center" style="height: 220px; background: rgba(3,7,18,0.5);">
                            <i class="fas fa-image fa-3x text-secondary opacity-50"></i>
                        </div>
                    }
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge @badgeClass shadow-sm backdrop-blur">@item.Type.ToString().ToUpper()</span>
                    </div>
                </div>
                
                <div class="p-4 flex-grow-1 d-flex flex-column">
                    <h5 class="fw-bold text-white text-truncate mb-2" style="font-family: var(--font-heading);">@item.Title</h5>
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-secondary bg-opacity-25 text-secondary fw-normal border border-secondary border-opacity-25 rounded-pill px-2 py-1" style="font-size: 0.75rem;">
                            <i class="fas fa-folder me-1"></i> @item.Category?.Name
                        </span>
                    </div>
                    <p class="text-secondary small text-truncate mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; white-space: normal;">@item.Description</p>
                </div>
                
                <div class="p-3 px-4 border-top border-light bg-dark bg-opacity-25 d-flex justify-content-between align-items-center mt-auto">
                    <small class="text-tertiary fw-medium"><i class="far fa-clock me-1"></i> @item.PostedAt.ToLocalTime().ToString("MMM dd")</small>
                    <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary rounded-pill px-3 fw-semibold">View</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="glass-panel text-center py-5 mt-4">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
            <i class="fas fa-box-open fa-3x text-secondary opacity-50"></i>
        </div>
        <h4 class="text-white fw-bold">No items found</h4>
        <p class="text-secondary mb-0">Be the first to post an item to the community.</p>
    </div>
}
