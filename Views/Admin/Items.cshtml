@model IEnumerable<WEBDEV_Project.Models.Item>
@{
    ViewData["Title"] = "Manage Items";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up border-bottom border-light pb-3">
    <div class="d-flex align-items-center">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; background: rgba(59, 130, 246, 0.15);">
            <i class="fas fa-boxes text-primary fs-5"></i>
        </div>
        <h2 class="fw-bold text-white mb-0" style="font-family: var(--font-heading);">Manage Items</h2>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-flex align-items-center transition-all hover-text-white">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

<div class="glass-panel mb-4 p-0 overflow-hidden animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="p-4 border-bottom border-light bg-dark bg-opacity-25">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="position-relative">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-dark bg-opacity-50 text-white border-light rounded-pill ps-4 shadow-inner" placeholder="Search by title or description..." />
                    <i class="fas fa-search position-absolute text-secondary" style="right: 15px; top: 50%; transform: translateY(-50%); pointer-events: none;"></i>
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select bg-dark bg-opacity-50 text-white border-light rounded-pill shadow-inner cursor-pointer" style="appearance: none;">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues(typeof(WEBDEV_Project.Models.ItemStatus)))
                    {
                        var isSelected = ViewBag.Status == s.ToString() ? "selected" : "";
                        <!option value="@s" @isSelected>@s</!option>
                    }
                    <!option value="Deleted" @(ViewBag.Status == "Deleted" ? "selected" : "")>Deleted</!option>
                </select>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium d-flex align-items-center">
                        <i class="fas fa-filter me-2"></i>Filter
                    </button>
                    <a asp-action="Items" class="btn btn-outline-secondary rounded-pill px-4 fw-medium d-flex align-items-center transition-all hover-text-white">Clear</a>
                </div>
            </div>
        </form>
    </div>
    
    <div class="p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-transparent mb-0">
                <thead class="text-uppercase small text-secondary bg-dark bg-opacity-50">
                    <tr>
                        <th class="ps-4 py-3 border-bottom border-light fw-bold tracking-wider">Title</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Type</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Category</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Status</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Date Posted</th>
                        <th class="text-end pe-4 py-3 border-bottom border-light fw-bold tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0 text-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                                    <i class="fas fa-box-open fa-3x text-secondary opacity-50"></i>
                                </div>
                                <p class="text-secondary fw-medium mb-0">No items found.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="border-bottom border-light transition-all hover-bg-light-subtle">
                            <td class="ps-4 py-3">
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-white text-decoration-none hover-text-primary transition-colors" target="_blank">
                                    @item.Title
                                </a>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-@(item.Type == WEBDEV_Project.Models.ItemType.Lost ? "danger" : "success") bg-opacity-25 border border-@(item.Type == WEBDEV_Project.Models.ItemType.Lost ? "danger" : "success") border-opacity-25 text-@(item.Type == WEBDEV_Project.Models.ItemType.Lost ? "danger" : "success") rounded-pill px-3 py-1 shadow-sm d-inline-flex align-items-center">
                                    <i class="fas @(item.Type == WEBDEV_Project.Models.ItemType.Lost ? "fa-search" : "fa-hand-holding") me-1 small"></i>
                                    @item.Type
                                </span>
                            </td>
                            <td class="py-3 text-secondary fw-medium">
                                <span class="bg-dark bg-opacity-50 px-2 py-1 rounded border border-light small"><i class="fas fa-tag me-1 text-primary opacity-75"></i>@item.Category?.Name</span>
                            </td>
                            <td class="py-3">
                                @if (item.IsDeleted)
                                {
                                    <span class="badge bg-secondary bg-opacity-25 border border-secondary border-opacity-50 text-secondary rounded-pill px-3 py-1">Deleted</span>
                                }
                                else
                                {
                                    var statusColor = item.Status == WEBDEV_Project.Models.ItemStatus.Active ? "info" : item.Status == WEBDEV_Project.Models.ItemStatus.Resolved ? "success" : "warning";
                                    <span class="badge bg-@statusColor bg-opacity-25 border border-@statusColor border-opacity-50 text-@statusColor rounded-pill px-3 py-1">@item.Status</span>
                                }
                            </td>
                            <td class="py-3 text-secondary fw-medium">@item.PostedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4 py-3">
                                <div class="d-flex gap-2 justify-content-end">
                                    @if (item.IsDeleted)
                                    {
                                        <form asp-action="RestoreItem" method="post" class="d-inline" onsubmit="return confirm('Restore this item?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-undo me-1"></i> Restore</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="RemoveItem" method="post" class="d-inline" onsubmit="return confirm('Delete this item?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-trash me-1"></i> Remove</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (ViewBag.TotalPages > 1)
    {
        <div class="p-4 border-top border-light bg-dark bg-opacity-25 d-flex justify-content-center">
            <nav aria-label="Item pagination">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white border-light transition-all hover-bg-primary-subtle" style="width: 32px; height: 32px;" asp-action="Items" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">
                            <i class="fas fa-chevron-left small"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center transition-all @(ViewBag.CurrentPage == i ? "bg-primary border-primary text-white shadow-sm" : "bg-dark bg-opacity-50 text-white border-light hover-bg-light-subtle")" style="width: 32px; height: 32px;" asp-action="Items" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white border-light transition-all hover-bg-primary-subtle" style="width: 32px; height: 32px;" asp-action="Items" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">
                            <i class="fas fa-chevron-right small"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
