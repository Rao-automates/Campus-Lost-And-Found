@model IEnumerable<WEBDEV_Project.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up border-bottom border-light pb-3">
    <div class="d-flex align-items-center">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; background: rgba(14, 165, 233, 0.15);">
            <i class="fas fa-users text-info fs-5"></i>
        </div>
        <h2 class="fw-bold text-white mb-0" style="font-family: var(--font-heading);">Manage Users</h2>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-flex align-items-center transition-all hover-text-white">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

<div class="glass-panel mb-4 p-0 overflow-hidden animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="p-4 border-bottom border-light bg-dark bg-opacity-25">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-8">
                <div class="position-relative">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-dark bg-opacity-50 text-white border-light rounded-pill ps-4 shadow-inner" placeholder="Search by name or email..." />
                    <i class="fas fa-search position-absolute text-secondary" style="right: 15px; top: 50%; transform: translateY(-50%); pointer-events: none;"></i>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium d-flex align-items-center">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                    <a asp-action="Users" class="btn btn-outline-secondary rounded-pill px-4 fw-medium d-flex align-items-center transition-all hover-text-white">Clear</a>
                </div>
            </div>
        </form>
    </div>
    
    <div class="p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-transparent mb-0">
                <thead class="text-uppercase small text-secondary bg-dark bg-opacity-50">
                    <tr>
                        <th class="ps-4 py-3 border-bottom border-light fw-bold tracking-wider">User</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Email</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Joined</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Status</th>
                        <th class="text-end pe-4 py-3 border-bottom border-light fw-bold tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0 text-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                                    <i class="fas fa-user-slash fa-3x text-secondary opacity-50"></i>
                                </div>
                                <p class="text-secondary fw-medium mb-0">No users found.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model)
                    {
                        <tr class="border-bottom border-light transition-all hover-bg-light-subtle">
                            <td class="ps-4 py-3 fw-bold fs-6">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(user.AvatarPath))
                                    {
                                        <img src="@user.AvatarPath" alt="@user.DisplayName" class="rounded-circle border border-secondary shadow-sm object-fit-cover" style="width: 40px; height: 40px;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark border border-secondary text-primary shadow-sm" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    }
                                    @user.DisplayName
                                </div>
                            </td>
                            <td class="py-3 text-secondary">@user.Email</td>
                            <td class="py-3 text-secondary fw-medium">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="py-3">
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-25 border border-success border-opacity-50 text-success rounded-pill px-3 py-1 shadow-sm d-inline-flex align-items-center">
                                        <i class="fas fa-check-circle me-1 small"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-25 border border-danger border-opacity-50 text-danger rounded-pill px-3 py-1 shadow-sm d-inline-flex align-items-center">
                                        <i class="fas fa-ban me-1 small"></i> Banned
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4 py-3">
                                <div class="d-flex gap-2 justify-content-end">
                                    @if (user.IsActive)
                                    {
                                        <form asp-action="BanUser" method="post" class="d-inline" onsubmit="return confirm('Ban this user? They will not be able to log in.');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-gavel me-1"></i> Ban</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="UnbanUser" method="post" class="d-inline" onsubmit="return confirm('Unban this user?');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-unlock me-1"></i> Unban</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('Permanently delete and anonymize this user? This action CANNOT be undone.');">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white" @(user.DisplayName == "Deleted User" ? "disabled" : "")><i class="fas fa-trash-alt me-1"></i> Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (ViewBag.TotalPages > 1)
    {
        <div class="p-4 border-top border-light bg-dark bg-opacity-25 d-flex justify-content-center">
            <nav aria-label="User pagination">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white border-light transition-all hover-bg-primary-subtle" style="width: 32px; height: 32px;" asp-action="Users" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">
                            <i class="fas fa-chevron-left small"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center transition-all @(ViewBag.CurrentPage == i ? "bg-primary border-primary text-white shadow-sm" : "bg-dark bg-opacity-50 text-white border-light hover-bg-light-subtle")" style="width: 32px; height: 32px;" asp-action="Users" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white border-light transition-all hover-bg-primary-subtle" style="width: 32px; height: 32px;" asp-action="Users" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">
                            <i class="fas fa-chevron-right small"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
