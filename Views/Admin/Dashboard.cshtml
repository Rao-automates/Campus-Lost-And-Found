@model WEBDEV_Project.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary mb-0"><i class="fas fa-cog me-2"></i>Admin Dashboard</h2>
</div>

<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card shadow-sm border-0 bg-primary text-white h-100 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Total Items</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalItems</h2>
                    </div>
                    <i class="fas fa-boxes fa-3x opacity-50"></i>
                </div>
            </div>
            <a asp-action="Items" class="card-footer text-white text-decoration-none d-flex justify-content-between align-items-center bg-dark bg-opacity-25 border-0">
                <span class="small">View Details</span>
                <i class="fas fa-angle-right"></i>
            </a>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card shadow-sm border-0 bg-success text-white h-100 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Resolved</h6>
                        <h2 class="fw-bold mb-0">@Model.ResolvedItems</h2>
                    </div>
                    <i class="fas fa-check-circle fa-3x opacity-50"></i>
                </div>
            </div>
            <a asp-action="Items" asp-route-status="Resolved" class="card-footer text-white text-decoration-none d-flex justify-content-between align-items-center bg-dark bg-opacity-25 border-0">
                <span class="small">View Details</span>
                <i class="fas fa-angle-right"></i>
            </a>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card shadow-sm border-0 bg-info text-white h-100 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Total Users</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalUsers</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
            </div>
            <a asp-action="Users" class="card-footer text-white text-decoration-none d-flex justify-content-between align-items-center bg-dark bg-opacity-25 border-0">
                <span class="small">Manage Users</span>
                <i class="fas fa-angle-right"></i>
            </a>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card shadow-sm border-0 bg-danger text-white h-100 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Flagged</h6>
                        <h2 class="fw-bold mb-0">@Model.FlaggedItemsCount</h2>
                    </div>
                    <i class="fas fa-flag fa-3x opacity-50"></i>
                </div>
            </div>
            <a asp-action="Flags" class="card-footer text-white text-decoration-none d-flex justify-content-between align-items-center bg-dark bg-opacity-25 border-0">
                <span class="small">Review Flags</span>
                <i class="fas fa-angle-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title fw-bold mb-0">Posting Activity (Last 12 Months)</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="activityChart" height="100"></canvas>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title fw-bold mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-3">
                    <a asp-action="Categories" class="btn btn-outline-primary text-start p-3">
                        <i class="fas fa-tags me-3 fs-5"></i> Manage Categories
                    </a>
                    <a asp-action="Announcement" class="btn btn-outline-primary text-start p-3">
                        <i class="fas fa-bullhorn me-3 fs-5"></i> Set Announcement
                    </a>
                    <a href="/hangfire" target="_blank" class="btn btn-outline-primary text-start p-3">
                        <i class="fas fa-cogs me-3 fs-5"></i> Background Jobs (Hangfire)
                    </a>
                    <a asp-action="Export" class="btn btn-outline-success text-start p-3">
                        <i class="fas fa-file-csv me-3 fs-5"></i> Export Data (CSV)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            var ctx = document.getElementById('activityChart').getContext('2d');
            
            var labels = @Html.Raw(Json.Serialize(Model.MonthlyStats.Select(s => s.Month)));
            var data = @Html.Raw(Json.Serialize(Model.MonthlyStats.Select(s => s.Count)));

            var myChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Items Posted',
                        data: data,
                        backgroundColor: 'rgba(13, 110, 253, 0.2)',
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        });
    </script>
}
