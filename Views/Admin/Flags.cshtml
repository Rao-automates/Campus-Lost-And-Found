@model IEnumerable<WEBDEV_Project.Models.Item>
@{
    ViewData["Title"] = "Review Flags";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up border-bottom border-light pb-3">
    <div class="d-flex align-items-center">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; background: rgba(239, 68, 68, 0.15);">
            <i class="fas fa-flag text-danger fs-5"></i>
        </div>
        <h2 class="fw-bold text-white mb-0" style="font-family: var(--font-heading);">Review Flagged Items</h2>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-flex align-items-center transition-all hover-text-white">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

<div class="glass-panel mb-4 p-0 overflow-hidden animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-transparent mb-0">
                <thead class="text-uppercase small text-secondary bg-dark bg-opacity-50">
                    <tr>
                        <th class="ps-4 py-3 border-bottom border-light fw-bold tracking-wider">Item</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Flag Count</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Date Posted</th>
                        <th class="text-end pe-4 py-3 border-bottom border-light fw-bold tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0 text-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                                    <i class="fas fa-flag-checkered fa-3x text-secondary opacity-50"></i>
                                </div>
                                <p class="text-secondary fw-medium mb-0">No flagged items.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="border-bottom border-light transition-all hover-bg-light-subtle">
                            <td class="ps-4 py-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 border border-light" style="width: 36px; height: 36px;">
                                        <i class="fas @(item.Type == WEBDEV_Project.Models.ItemType.Lost ? "fa-search text-danger" : "fa-hand-holding text-success") small"></i>
                                    </div>
                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-primary text-decoration-none hover-glow transition-colors" target="_blank">
                                        @item.Title
                                    </a>
                                </div>
                            </td>
                            <td class="py-4">
                                <span class="badge bg-danger bg-opacity-25 border border-danger border-opacity-50 text-danger rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center">
                                    <i class="fas fa-flag me-1 small"></i> @item.FlagCount
                                </span>
                            </td>
                            <td class="py-4 text-secondary fw-medium">@item.PostedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4 py-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <form asp-action="DismissFlags" method="post" class="d-inline" onsubmit="return confirm('Dismiss all flags for this item?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-check me-1"></i> Dismiss</button>
                                    </form>
                                    <form asp-action="RemoveItem" method="post" class="d-inline" onsubmit="return confirm('Delete this item?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-trash me-1"></i> Remove</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (ViewBag.TotalPages > 1)
    {
        <div class="p-4 border-top border-light bg-dark bg-opacity-25 d-flex justify-content-center">
            <nav aria-label="Flag pagination">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white border-light transition-all hover-bg-primary-subtle" style="width: 32px; height: 32px;" asp-action="Flags" asp-route-page="@(ViewBag.CurrentPage - 1)">
                            <i class="fas fa-chevron-left small"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center transition-all @(ViewBag.CurrentPage == i ? "bg-primary border-primary text-white shadow-sm" : "bg-dark bg-opacity-50 text-white border-light hover-bg-light-subtle")" style="width: 32px; height: 32px;" asp-action="Flags" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white border-light transition-all hover-bg-primary-subtle" style="width: 32px; height: 32px;" asp-action="Flags" asp-route-page="@(ViewBag.CurrentPage + 1)">
                            <i class="fas fa-chevron-right small"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
