@model IEnumerable<WEBDEV_Project.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up border-bottom border-light pb-3">
    <div class="d-flex align-items-center">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; background: rgba(59, 130, 246, 0.15);">
            <i class="fas fa-tags text-primary fs-5"></i>
        </div>
        <h2 class="fw-bold text-white mb-0" style="font-family: var(--font-heading);">Manage Categories</h2>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 d-flex align-items-center shadow-sm" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fas fa-plus me-2"></i>New Category
        </button>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-flex align-items-center transition-all hover-text-white">
            <i class="fas fa-arrow-left me-2"></i>Back
        </a>
    </div>
</div>

<div class="glass-panel mb-4 p-0 overflow-hidden animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-transparent mb-0">
                <thead class="text-uppercase small text-secondary bg-dark bg-opacity-50">
                    <tr>
                        <th class="ps-4 py-3 border-bottom border-light fw-bold tracking-wider">Name</th>
                        <th class="py-3 border-bottom border-light fw-bold tracking-wider">Slug</th>
                        <th class="text-end pe-4 py-3 border-bottom border-light fw-bold tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0 text-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                                    <i class="fas fa-tags fa-3x text-secondary opacity-50"></i>
                                </div>
                                <p class="text-secondary fw-medium mb-0">No categories found.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var cat in Model)
                    {
                        <tr class="border-bottom border-light transition-all hover-bg-light-subtle">
                            <td class="ps-4 py-4 fw-bold fs-6">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark bg-opacity-50 border border-light" style="width: 32px; height: 32px;">
                                        <i class="fas fa-tag text-primary small"></i>
                                    </div>
                                    @cat.Name
                                </div>
                            </td>
                            <td class="py-4 font-monospace text-secondary">
                                <span class="bg-dark bg-opacity-50 px-2 py-1 rounded border border-light small">@cat.Slug</span>
                            </td>
                            <td class="text-end pe-4 py-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white" data-bs-toggle="modal" data-bs-target="#editModal-@cat.Id">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </button>
                                    <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 d-flex align-items-center transition-all hover-text-white"><i class="fas fa-trash me-1"></i> Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        
                        <!-- Edit Modal -->
                        <div class="modal fade" id="editModal-@cat.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content glass-panel p-0 overflow-hidden border-info border-opacity-25">
                                    <form asp-action="EditCategory" method="post">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <div class="modal-header border-bottom border-light bg-info bg-opacity-10 p-4">
                                            <h5 class="modal-title text-info fw-bold d-flex align-items-center" style="font-family: var(--font-heading);">
                                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: rgba(14, 165, 233, 0.15);">
                                                    <i class="fas fa-edit"></i>
                                                </div>
                                                Edit Category
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-white p-4">
                                            <div class="mb-4">
                                                <label class="form-label text-secondary fw-medium small mb-2 text-uppercase tracking-wider">Category Name</label>
                                                <input type="text" name="name" class="form-control bg-dark bg-opacity-50 text-white border-light rounded-3 p-3 shadow-inner" value="@cat.Name" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-secondary fw-medium small mb-2 text-uppercase tracking-wider">Slug</label>
                                                <input type="text" name="slug" class="form-control bg-dark bg-opacity-50 text-secondary border-light rounded-3 p-3 font-monospace shadow-inner" value="@cat.Slug" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top border-light bg-dark bg-opacity-50 p-4">
                                            <button type="button" class="btn btn-secondary px-4 py-2 fw-medium" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-info px-4 py-2 fw-bold text-dark shadow-sm">Save Changes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel p-0 overflow-hidden border-primary border-opacity-25">
            <form asp-action="CreateCategory" method="post">
                <div class="modal-header border-bottom border-light bg-primary bg-opacity-10 p-4">
                    <h5 class="modal-title text-primary fw-bold d-flex align-items-center" style="font-family: var(--font-heading);">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.15);">
                            <i class="fas fa-plus"></i>
                        </div>
                        New Category
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-white p-4">
                    <div class="mb-4">
                        <label class="form-label text-secondary fw-medium small mb-2 text-uppercase tracking-wider">Category Name</label>
                        <input type="text" name="name" class="form-control bg-dark bg-opacity-50 text-white border-light rounded-3 p-3 shadow-inner" placeholder="e.g. Electronics" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-medium small mb-2 text-uppercase tracking-wider">Slug</label>
                        <input type="text" name="slug" class="form-control bg-dark bg-opacity-50 text-white border-light rounded-3 p-3 font-monospace shadow-inner" placeholder="e.g. electronics" required />
                    </div>
                </div>
                <div class="modal-footer border-top border-light bg-dark bg-opacity-50 p-4">
                    <button type="button" class="btn btn-secondary px-4 py-2 fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
