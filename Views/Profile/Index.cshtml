@model WEBDEV_Project.ViewModels.ProfileDashboardViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row animate-fade-in-up">
    <!-- Left Sidebar: Profile Summary -->
    <div class="col-lg-3 mb-4">
        <div class="glass-panel sticky-top p-0 overflow-hidden" style="top: 100px;">
            <div class="p-4 text-center border-bottom border-light" style="background: radial-gradient(circle at top, rgba(139, 92, 246, 0.15), transparent 70%);">
                <div class="position-relative d-inline-block mb-3">
                    @if (!string.IsNullOrEmpty(Model.User.AvatarPath))
                    {
                        <img src="@Model.User.AvatarPath" alt="Profile Avatar" class="rounded-circle shadow-lg" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid rgba(255,255,255,0.1);">
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 120px; height: 120px; background: rgba(255,255,255,0.05); border: 4px solid rgba(255,255,255,0.1); margin: 0 auto;">
                            <i class="fas fa-user text-secondary opacity-50 fa-3x"></i>
                        </div>
                    }
                </div>
                <h4 class="fw-bold mb-1 text-white" style="font-family: var(--font-heading);">@Model.User.DisplayName</h4>
                <p class="text-secondary small fw-medium mb-3">Member since @Model.User.CreatedAt.ToString("MMM yyyy")</p>
                
                @if (!string.IsNullOrEmpty(Model.User.Bio))
                {
                    <p class="small text-secondary mb-3 fst-italic">"@Model.User.Bio"</p>
                }

                <div class="d-flex justify-content-center align-items-center mb-4 px-3 py-2 rounded-pill bg-dark bg-opacity-50 border border-light mx-auto" style="width: fit-content;">
                    <div class="text-warning d-flex align-items-center gap-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.AverageRating))
                            {
                                <i class="fas fa-star"></i>
                            }
                            else
                            {
                                <i class="far fa-star text-warning opacity-50"></i>
                            }
                        }
                    </div>
                    <span class="text-white fw-bold ms-2">@Model.AverageRating.ToString("0.0")</span>
                </div>

                <div class="d-grid">
                    <a asp-action="Edit" class="btn btn-outline-primary py-2 rounded-pill fw-semibold">
                        <i class="fas fa-user-edit me-2"></i>Edit Profile
                    </a>
                </div>
            </div>
            
            <div class="p-0">
                <div class="list-group list-group-flush bg-transparent">
                    <a asp-action="Index" asp-route-tab="active" class="list-group-item list-group-item-action bg-transparent text-white border-bottom border-light px-4 py-3 d-flex justify-content-between align-items-center @(Model.ActiveTab == "active" ? "active" : "")" style="@(Model.ActiveTab == "active" ? "background: linear-gradient(90deg, rgba(139, 92, 246, 0.2), transparent) !important; border-left: 3px solid var(--accent-primary) !important;" : "border-left: 3px solid transparent !important;")">
                        <span class="fw-medium"><i class="fas fa-box-open w-20px me-2 text-primary"></i>Active Posts</span>
                        <span class="badge bg-primary rounded-pill">@Model.PostCount</span>
                    </a>
                    <a asp-action="Index" asp-route-tab="resolved" class="list-group-item list-group-item-action bg-transparent text-white border-bottom border-light px-4 py-3 d-flex justify-content-between align-items-center @(Model.ActiveTab == "resolved" ? "active" : "")" style="@(Model.ActiveTab == "resolved" ? "background: linear-gradient(90deg, rgba(16, 185, 129, 0.2), transparent) !important; border-left: 3px solid var(--accent-primary) !important;" : "border-left: 3px solid transparent !important;")">
                        <span class="fw-medium"><i class="fas fa-check-circle w-20px me-2 text-success"></i>Resolved</span>
                        <span class="badge bg-success rounded-pill">@Model.ResolvedCount</span>
                    </a>
                    <a asp-action="Index" asp-route-tab="claims" class="list-group-item list-group-item-action bg-transparent text-white border-bottom border-light px-4 py-3 d-flex justify-content-between align-items-center @(Model.ActiveTab == "claims" ? "active" : "")" style="@(Model.ActiveTab == "claims" ? "background: linear-gradient(90deg, rgba(245, 158, 11, 0.2), transparent) !important; border-left: 3px solid var(--accent-primary) !important;" : "border-left: 3px solid transparent !important;")">
                        <span class="fw-medium"><i class="fas fa-hand-paper w-20px me-2 text-warning"></i>My Claims</span>
                        <span class="badge bg-warning text-dark rounded-pill">@Model.ClaimCount</span>
                    </a>
                    <a asp-action="Index" asp-route-tab="bookmarks" class="list-group-item list-group-item-action bg-transparent text-white border-0 px-4 py-3 d-flex justify-content-between align-items-center @(Model.ActiveTab == "bookmarks" ? "active" : "")" style="@(Model.ActiveTab == "bookmarks" ? "background: linear-gradient(90deg, rgba(255, 255, 255, 0.1), transparent) !important; border-left: 3px solid var(--accent-primary) !important;" : "border-left: 3px solid transparent !important;")">
                        <span class="fw-medium"><i class="fas fa-bookmark w-20px me-2 text-secondary"></i>Saved</span>
                        <span class="badge bg-secondary bg-opacity-50 rounded-pill">@Model.BookmarkCount</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Content Area -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-light pb-3">
            <h3 class="fw-bold mb-0 text-capitalize text-white" style="font-family: var(--font-heading);">@Model.ActiveTab Items</h3>
            <a asp-controller="Items" asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="fas fa-plus me-2"></i>Post New Item
            </a>
        </div>

        @if (Model.ActiveTab == "active")
        {
            @await Html.PartialAsync("_ItemGrid", Model.ActiveItems)
        }
        else if (Model.ActiveTab == "resolved")
        {
            @await Html.PartialAsync("_ItemGrid", Model.ResolvedItems)
        }
        else if (Model.ActiveTab == "bookmarks")
        {
            @await Html.PartialAsync("_ItemGrid", Model.BookmarkedItems)
        }
        else if (Model.ActiveTab == "claims")
        {
            @if (!Model.MyClaims.Any())
            {
                <div class="glass-panel text-center py-5 mt-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                        <i class="fas fa-hand-paper fa-3x text-secondary opacity-50"></i>
                    </div>
                    <h4 class="text-white fw-bold">You haven't made any claims</h4>
                    <p class="text-secondary mb-0">Items you claim will appear here.</p>
                </div>
            }
            else
            {
                <div class="glass-panel p-0 overflow-hidden">
                    <div class="list-group list-group-flush bg-transparent">
                        @foreach (var claim in Model.MyClaims)
                        {
                            var claimColor = claim.Status == WEBDEV_Project.Models.ClaimStatus.Pending ? "warning" : 
                                             claim.Status == WEBDEV_Project.Models.ClaimStatus.Approved ? "success" : "danger";
                            <div class="list-group-item list-group-item-action p-4 border-bottom border-light bg-transparent text-white interactive">
                                <div class="d-flex w-100 justify-content-between align-items-start mb-3">
                                    <h5 class="mb-0 fw-bold text-truncate pe-3" style="font-family: var(--font-heading);">
                                        <a asp-controller="Items" asp-action="Details" asp-route-id="@claim.ItemId" class="text-white text-decoration-none hover-text-primary transition-all">@claim.Item?.Title</a>
                                    </h5>
                                    <span class="badge bg-@claimColor bg-opacity-25 text-@claimColor border border-@claimColor border-opacity-25 px-3 py-2 rounded-pill">@claim.Status.ToString().ToUpper()</span>
                                </div>
                                <div class="d-flex align-items-center text-secondary small fw-medium mb-3">
                                    <i class="far fa-clock me-2"></i> Claimed on @claim.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </div>
                                <div class="bg-dark bg-opacity-25 p-3 rounded-4 border border-light mb-4">
                                    <p class="mb-0 text-secondary fst-italic">"@claim.Message"</p>
                                </div>
                                
                                <div class="d-flex justify-content-end">
                                    <a asp-controller="Messages" asp-action="Thread" asp-route-claimId="@claim.Id" class="btn btn-secondary px-4 py-2">
                                        <i class="fas fa-comments me-2"></i>Message Thread
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
