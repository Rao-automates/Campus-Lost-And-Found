@model WEBDEV_Project.ViewModels.ProfileEditViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center animate-fade-in-up">
    <div class="col-md-8 col-lg-6">
        <div class="glass-panel p-0 overflow-hidden mb-5">
            <div class="p-4 p-md-5 border-bottom border-light bg-dark bg-opacity-25 d-flex align-items-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-4 shadow-lg" style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary));">
                    <i class="fas fa-user-edit fa-2x text-white"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-white mb-1" style="font-family: var(--font-heading);">Edit Profile</h3>
                    <p class="text-secondary mb-0">Update your personal information and avatar.</p>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-4 mb-4"></div>

                    <div class="text-center mb-5">
                        <div class="position-relative d-inline-block mb-3">
                            @if (!string.IsNullOrEmpty(Model.CurrentAvatarPath))
                            {
                                <img src="@Model.CurrentAvatarPath" alt="Current Avatar" class="rounded-circle shadow-lg" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid rgba(255,255,255,0.1);" />
                            }
                            else
                            {
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-lg" style="width: 120px; height: 120px; background: rgba(255,255,255,0.05); border: 4px solid rgba(255,255,255,0.1);">
                                    <i class="fas fa-user fa-4x text-secondary opacity-50"></i>
                                </div>
                            }
                        </div>
                        <div class="bg-dark bg-opacity-25 p-3 rounded-4 border border-light mx-auto" style="max-width: 300px;">
                            <label asp-for="AvatarFile" class="form-label text-secondary fw-medium small mb-2 d-block">Update Profile Picture</label>
                            <input asp-for="AvatarFile" class="form-control form-control-sm text-secondary bg-transparent border-light" type="file" accept="image/*" />
                            <span asp-validation-for="AvatarFile" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="DisplayName" class="form-label">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" />
                        <span asp-validation-for="DisplayName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number (Optional)</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="Bio" class="form-label">Bio (Optional)</label>
                        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us a little about yourself..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-4 border-top border-light flex-wrap gap-3">
                        <button type="button" class="btn btn-outline-danger px-4 py-2" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                            <i class="fas fa-trash-alt me-2"></i> Delete Account
                        </button>
                        <div class="d-flex gap-3">
                            <a asp-action="Index" class="btn btn-secondary px-4 py-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 py-2">Save Changes</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Account Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel border-danger border-opacity-50 p-0 overflow-hidden">
            <div class="modal-header border-danger border-opacity-25 bg-danger bg-opacity-10 p-4">
                <h5 class="modal-title text-danger fw-bold d-flex align-items-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: rgba(239, 68, 68, 0.15);">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    Delete Account
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white p-4">
                <p class="fs-5 mb-4">Are you sure you want to delete your account? This action <strong class="text-danger">cannot be undone</strong>.</p>
                <div class="bg-dark bg-opacity-25 p-3 rounded-4 border border-light">
                    <p class="small text-secondary mb-0 fw-medium"><i class="fas fa-info-circle me-2"></i>Note: To preserve community history, your past posts and ratings will remain, but your name and profile will be anonymized to "Deleted User".</p>
                </div>
            </div>
            <div class="modal-footer border-danger border-opacity-25 bg-dark bg-opacity-50 p-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteAccount" method="post">
                    <button type="submit" class="btn btn-danger px-4">Yes, Delete My Account</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
