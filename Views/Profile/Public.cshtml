@model WEBDEV_Project.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = $"{Model.User.DisplayName}'s Profile";
}

<div class="row animate-fade-in-up">
    <!-- Left Sidebar: Profile Info -->
    <div class="col-md-4 mb-4">
        <div class="glass-panel text-center p-0 overflow-hidden sticky-top" style="top: 100px;">
            <div class="p-4 border-bottom border-light" style="background: radial-gradient(circle at top, rgba(139, 92, 246, 0.15), transparent 70%);">
                @if (!string.IsNullOrEmpty(Model.User.AvatarPath))
                {
                    <img src="@Model.User.AvatarPath" alt="Avatar" class="rounded-circle mb-3 shadow-lg" style="width: 150px; height: 150px; object-fit: cover; border: 4px solid rgba(255,255,255,0.1);" />
                }
                else
                {
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-lg" style="width: 150px; height: 150px; background: rgba(255,255,255,0.05); border: 4px solid rgba(255,255,255,0.1);">
                        <i class="fas fa-user fa-5x text-secondary opacity-50"></i>
                    </div>
                }
                <h3 class="fw-bold text-white mb-1" style="font-family: var(--font-heading);">@Model.User.DisplayName</h3>
                <p class="text-secondary small fw-medium mb-3">Joined @Model.User.CreatedAt.ToString("MMM yyyy")</p>

                <div class="d-flex justify-content-center align-items-center mb-4 px-3 py-2 rounded-pill bg-dark bg-opacity-50 border border-light mx-auto" style="width: fit-content;">
                    <div class="text-warning fs-5 d-flex align-items-center gap-1 me-2">
                        @for (int i = 0; i < Math.Floor(Model.AverageRating); i++)
                        {
                            <i class="fas fa-star"></i>
                        }
                        @if (Model.AverageRating - Math.Floor(Model.AverageRating) >= 0.5)
                        {
                            <i class="fas fa-star-half-alt"></i>
                        }
                        @for (int i = (int)Math.Ceiling(Model.AverageRating); i < 5; i++)
                        {
                            <i class="far fa-star text-warning opacity-50"></i>
                        }
                    </div>
                    <span class="text-white fw-bold fs-5">@Model.AverageRating.ToString("0.0")</span>
                </div>
                <div class="text-secondary small fw-medium mb-3">Based on @Model.Ratings.Count() reviews</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.User.Bio))
            {
                <div class="p-4 bg-dark bg-opacity-25">
                    <p class="text-start text-secondary mb-0 fst-italic lh-lg" style="white-space: pre-line;">"@Model.User.Bio"</p>
                </div>
            }
        </div>
    </div>

    <!-- Right Content: Active Items & Reviews -->
    <div class="col-md-8">
        <!-- Active Items -->
        <h4 class="fw-bold text-white mb-4 d-flex align-items-center" style="font-family: var(--font-heading);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.15);">
                <i class="fas fa-boxes text-primary"></i>
            </div>
            Active Posts
        </h4>
        
        @if (!Model.ActiveItems.Any())
        {
            <div class="glass-panel text-center py-5 mb-5">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                    <i class="fas fa-box-open fa-3x text-secondary opacity-50"></i>
                </div>
                <h5 class="text-white fw-bold mb-1">No Active Posts</h5>
                <p class="text-secondary mb-0">This user currently has no active posts.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
                @foreach (var item in Model.ActiveItems)
                {
                    <div class="col">
                        <partial name="_ItemGrid" model="item" />
                    </div>
                }
            </div>
        }

        <!-- Reviews -->
        <h4 class="fw-bold text-white mb-4 d-flex align-items-center" style="font-family: var(--font-heading);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px; background: rgba(245, 158, 11, 0.15);">
                <i class="fas fa-star text-warning"></i>
            </div>
            Recent Reviews
        </h4>
        
        @if (!Model.Ratings.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                    <i class="fas fa-comment-slash fa-3x text-secondary opacity-50"></i>
                </div>
                <h5 class="text-white fw-bold mb-1">No Reviews Yet</h5>
                <p class="text-secondary mb-0">This user hasn't received any reviews yet.</p>
            </div>
        }
        else
        {
            <div class="glass-panel p-0 overflow-hidden">
                <div class="list-group list-group-flush bg-transparent">
                    @foreach (var rating in Model.Ratings)
                    {
                        <div class="list-group-item bg-transparent border-bottom border-light p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="text-warning fs-6 bg-dark bg-opacity-50 px-2 py-1 rounded-pill border border-light">
                                        @for (int i = 0; i < rating.Stars; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        @for (int i = rating.Stars; i < 5; i++)
                                        {
                                            <i class="far fa-star text-warning opacity-50"></i>
                                        }
                                    </div>
                                    <h6 class="text-white fw-bold mb-0">
                                        <a asp-controller="Profile" asp-action="Public" asp-route-id="@rating.RaterId" class="text-white text-decoration-none hover-text-primary transition-all">@rating.Rater?.DisplayName</a>
                                    </h6>
                                </div>
                                <small class="text-secondary fw-medium">@rating.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</small>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(rating.Comment))
                            {
                                <div class="bg-dark bg-opacity-25 p-3 rounded-4 border border-light mb-3">
                                    <p class="text-secondary mb-0 fst-italic">"@rating.Comment"</p>
                                </div>
                            }
                            
                            <div class="small fw-medium">
                                <span class="text-secondary">Reviewed for: </span>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@rating.ItemId" class="text-primary text-decoration-none transition-all">@rating.Item?.Title</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
