@model WEBDEV_Project.ViewModels.EditItemViewModel
@{
    ViewData["Title"] = "Edit Item";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-panel mt-4 mb-5 p-0 overflow-hidden animate-fade-in-up">
            <div class="p-4 p-md-5 border-bottom border-light bg-dark bg-opacity-25 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-4" style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary));">
                        <i class="fas fa-edit fa-2x text-white"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-white mb-1" style="font-family: var(--font-heading);">Edit Item</h3>
                        <p class="text-secondary mb-0">Update information for your posted item.</p>
                    </div>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
            <div class="p-4 p-md-5">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-4 mb-4"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label asp-for="Type" class="form-label">Type</label>
                                <select asp-for="Type" class="form-select border-light text-white" style="background-color: transparent;" asp-items="Html.GetEnumSelectList<WEBDEV_Project.Models.ItemType>()"></select>
                                <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CategoryId" class="form-label">Category</label>
                                <select asp-for="CategoryId" class="form-select border-light text-white" style="background-color: transparent;" asp-items="ViewBag.Categories">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label asp-for="BuildingId" class="form-label">Campus Building</label>
                                <select asp-for="BuildingId" class="form-select border-light text-white" style="background-color: transparent;" asp-items="ViewBag.Buildings">
                                    <option value="">-- Select Building --</option>
                                </select>
                                <span asp-validation-for="BuildingId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="LocationDetail" class="form-label">Specific Location</label>
                                <input asp-for="LocationDetail" class="form-control" />
                                <span asp-validation-for="LocationDetail" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label asp-for="DateOccurred" class="form-label">Date Occurred</label>
                                <input asp-for="DateOccurred" class="form-control" />
                                <span asp-validation-for="DateOccurred" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ExpiresAt" class="form-label">Expires At</label>
                                <input asp-for="ExpiresAt" class="form-control" />
                                <span asp-validation-for="ExpiresAt" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4" id="rewardSection">
                        <label asp-for="Reward" class="form-label">Reward Amount</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0 border-light bg-transparent text-secondary">$</span>
                            <input asp-for="Reward" class="form-control border-start-0 border-light ps-0" style="background-color: transparent;" type="number" step="0.01" min="0" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Reward" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group mb-5 p-4 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.1);">
                        <label asp-for="Images" class="form-label d-block text-center mb-3">
                            <i class="fas fa-cloud-upload-alt fa-3x text-secondary opacity-50 mb-2"></i><br/>
                            <span class="text-white">Upload Additional Images</span>
                        </label>
                        <input asp-for="Images" class="form-control" type="file" multiple accept="image/jpeg,image/png,image/gif,image/webp" />
                        <span asp-validation-for="Images" class="text-danger small mt-1 d-block text-center"></span>
                        <div class="form-text text-secondary mt-3 text-center">Add more images (up to 5 total limit). Existing images will not be removed.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-4 border-top border-light">
                        <button type="submit" class="btn btn-primary px-5 py-2">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Toggle Reward based on Type
            function toggleReward() {
                var type = $('#Type').val();
                if (type == '0') { // Lost
                    $('#rewardSection').show();
                } else {
                    $('#rewardSection').hide();
                    $('#Reward').val('');
                }
            }

            $('#Type').change(toggleReward);
            toggleReward(); // Initial state
        });
    </script>
}
