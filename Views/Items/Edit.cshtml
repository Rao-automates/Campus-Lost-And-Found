@model WEBDEV_Project.ViewModels.EditItemViewModel
@{
    ViewData["Title"] = "Edit Item";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mt-4 mb-5">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold text-primary mb-0"><i class="fas fa-edit me-2"></i>Edit Item</h3>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label fw-bold"></label>
                            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<WEBDEV_Project.Models.ItemType>()"></select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BuildingId" class="form-label fw-bold"></label>
                            <select asp-for="BuildingId" class="form-select" asp-items="ViewBag.Buildings">
                                <option value="">-- Select Building --</option>
                            </select>
                            <span asp-validation-for="BuildingId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LocationDetail" class="form-label fw-bold"></label>
                            <input asp-for="LocationDetail" class="form-control" />
                            <span asp-validation-for="LocationDetail" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateOccurred" class="form-label fw-bold"></label>
                            <input asp-for="DateOccurred" class="form-control" />
                            <span asp-validation-for="DateOccurred" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpiresAt" class="form-label fw-bold"></label>
                            <input asp-for="ExpiresAt" class="form-control" />
                            <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3" id="rewardSection">
                        <label asp-for="Reward" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Reward" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Reward" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 border p-3 bg-light rounded">
                        <label asp-for="Images" class="form-label fw-bold"></label>
                        <input asp-for="Images" class="form-control" type="file" multiple accept="image/jpeg,image/png,image/gif,image/webp" />
                        <span asp-validation-for="Images" class="text-danger small"></span>
                        <div class="form-text">Add more images (up to 5 total limit). Existing images will not be removed.</div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-4">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light shadow-sm me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-primary shadow-sm px-5">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Toggle Reward based on Type
            function toggleReward() {
                var type = $('#Type').val();
                if (type == '0') { // Lost
                    $('#rewardSection').show();
                } else {
                    $('#rewardSection').hide();
                    $('#Reward').val('');
                }
            }

            $('#Type').change(toggleReward);
            toggleReward(); // Initial state
        });
    </script>
}
