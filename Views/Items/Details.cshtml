@model WEBDEV_Project.ViewModels.ItemDetailViewModel
@{
    ViewData["Title"] = Model.Item.Title;
}

<div class="row animate-fade-in-up">
    <div class="col-lg-8 mb-4">
        <div class="glass-panel overflow-hidden p-0 mb-4">
            <!-- Carousel for Images -->
            @if (Model.Item.Images.Any())
            {
                <div id="itemCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-indicators mb-2">
                        @for (int i = 0; i < Model.Item.Images.Count; i++)
                        {
                            <button type="button" data-bs-target="#itemCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                        }
                    </div>
                    <div class="carousel-inner bg-dark bg-opacity-50" style="height: 450px;">
                        @foreach (var img in Model.Item.Images.Select((value, index) => new { value, index }))
                        {
                            <div class="carousel-item h-100 @(img.index == 0 ? "active" : "")">
                                <img src="@img.value.Path" class="d-block w-100 h-100" style="object-fit: contain; backdrop-filter: blur(8px);" alt="Item Image @img.index">
                            </div>
                        }
                    </div>
                    @if (Model.Item.Images.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#itemCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark bg-opacity-75 rounded-circle p-3 shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#itemCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark bg-opacity-75 rounded-circle p-3 shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-dark bg-opacity-25 d-flex align-items-center justify-content-center text-secondary" style="height: 300px;">
                    <div class="text-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                            <i class="fas fa-image fa-3x opacity-50"></i>
                        </div>
                        <p class="mb-0 fw-medium">No images available for this item.</p>
                    </div>
                </div>
            }

            <div class="p-4 p-md-5 position-relative">
                <div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-3">
                    <div>
                        <span class="badge @(Model.Item.Type == WEBDEV_Project.Models.ItemType.Lost ? "badge-lost" : "badge-found") shadow-sm mb-3 fs-6 px-3 py-2">
                            @Model.Item.Type.ToString().ToUpper()
                        </span>
                        <h2 class="fw-bold text-white mb-0" style="font-family: var(--font-heading);">@Model.Item.Title</h2>
                    </div>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary rounded-circle shadow-sm btn-bookmark d-flex align-items-center justify-content-center p-0" data-id="@Model.Item.Id" title="Save this item" style="width: 44px; height: 44px;">
                                <i class="@(Model.IsBookmarked ? "fas text-primary" : "far text-white") fa-bookmark fs-5"></i>
                            </button>
                            <button class="btn btn-outline-danger rounded-circle shadow-sm btn-flag d-flex align-items-center justify-content-center p-0" data-id="@Model.Item.Id" title="Report this item" data-bs-toggle="modal" data-bs-target="#flagModal" style="width: 44px; height: 44px;">
                                <i class="far fa-flag fs-5"></i>
                            </button>
                        </div>
                    }
                </div>

                <div class="row text-secondary small mb-4 bg-dark bg-opacity-25 p-3 rounded-4 border border-light">
                    <div class="col-md-4 mb-2 mb-md-0 d-flex align-items-center">
                        <i class="fas fa-user-circle text-primary me-2 fs-5"></i> 
                        <span>Posted by: <a asp-controller="Profile" asp-action="Public" asp-route-id="@Model.Item.UserId" class="text-white text-decoration-none fw-semibold">@Model.Item.User?.DisplayName</a></span>
                    </div>
                    <div class="col-md-4 mb-2 mb-md-0 d-flex align-items-center">
                        <i class="far fa-clock text-primary me-2 fs-5"></i> 
                        <span>@Model.Item.PostedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <i class="fas fa-eye text-primary me-2 fs-5"></i> 
                        <span>@Model.Item.ViewCount Views</span>
                    </div>
                </div>

                <h5 class="fw-bold mb-3 text-white">Description</h5>
                <p class="text-secondary mb-4 fs-6 lh-lg" style="white-space: pre-line;">@Model.Item.Description</p>

                <h5 class="fw-bold mb-3 text-white">Details</h5>
                <ul class="list-group list-group-flush border border-light rounded-4 overflow-hidden mb-4 bg-transparent">
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-dark bg-opacity-25 py-3 border-bottom border-light">
                        <span class="text-secondary"><i class="fas fa-folder me-2 w-20px"></i>Category</span>
                        <span class="fw-semibold text-white">@Model.Item.Category?.Name</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-dark bg-opacity-25 py-3 border-bottom border-light">
                        <span class="text-secondary"><i class="fas fa-building me-2 w-20px"></i>Campus Building</span>
                        <span class="fw-semibold text-white">@(Model.Item.Building?.Name ?? "Not specified")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-dark bg-opacity-25 py-3 border-bottom border-light">
                        <span class="text-secondary"><i class="fas fa-map-marker-alt me-2 w-20px"></i>Specific Location</span>
                        <span class="fw-semibold text-white">@(Model.Item.LocationDetail ?? "Not specified")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-dark bg-opacity-25 py-3 border-bottom border-light">
                        <span class="text-secondary"><i class="far fa-calendar-alt me-2 w-20px"></i>Date Occurred</span>
                        <span class="fw-semibold text-white">@Model.Item.DateOccurred.ToString("MMM dd, yyyy")</span>
                    </li>
                    @if (Model.Item.Reward.HasValue && Model.Item.Reward > 0)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3" style="background: rgba(16, 185, 129, 0.1);">
                            <span class="text-success fw-bold"><i class="fas fa-gift me-2 w-20px"></i>Reward Offered</span>
                            <span class="text-success fw-bold fs-5">@Model.Item.Reward.Value.ToString("C")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-lg-4">
        <!-- Status & Actions Card -->
        <div class="glass-panel mb-4 sticky-top" style="top: 100px;">
            <div class="text-center p-4">
                <h5 class="fw-bold mb-4 text-white">Item Status</h5>
                
                @if (Model.Item.Status == WEBDEV_Project.Models.ItemStatus.Resolved)
                {
                    <div class="rounded-4 py-4 mb-4" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3);">
                        <i class="fas fa-check-circle fa-3x text-success mb-3 shadow-sm rounded-circle"></i>
                        <h5 class="text-success fw-bold tracking-wider mb-0">RESOLVED</h5>
                    </div>

                    @if (User.Identity!.IsAuthenticated && Model.UserToRate != null)
                    {
                        <hr class="border-light opacity-50 mb-4" />
                        <h6 class="text-secondary fw-bold mb-3">Rate Your Experience</h6>
                        
                        @if (Model.ExistingRating != null)
                        {
                            <div class="p-3 mb-4 rounded-4" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2);">
                                <div class="text-success mb-2 fs-5">
                                    @for (int i = 0; i < Model.ExistingRating.Stars; i++)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    @for (int i = Model.ExistingRating.Stars; i < 5; i++)
                                    {
                                        <i class="far fa-star text-success opacity-50"></i>
                                    }
                                </div>
                                <p class="small mb-0 fst-italic text-white">"@Model.ExistingRating.Comment"</p>
                                <div class="small text-secondary mt-2 text-end">- You rated <a asp-controller="Profile" asp-action="Public" asp-route-id="@Model.UserToRate.Id" class="text-primary fw-bold text-decoration-none">@Model.UserToRate.DisplayName</a></div>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 mb-4 rounded-4 bg-dark bg-opacity-25 border border-light">
                                <p class="small text-secondary mb-3">Leave a review for <a asp-controller="Profile" asp-action="Public" asp-route-id="@Model.UserToRate.Id" class="text-primary fw-bold text-decoration-none">@Model.UserToRate.DisplayName</a></p>
                                <form asp-action="SubmitRating" method="post">
                                    <input type="hidden" name="itemId" value="@Model.Item.Id" />
                                    <input type="hidden" name="ratedUserId" value="@Model.UserToRate.Id" />
                                    <div class="mb-3">
                                        <select name="stars" class="form-select bg-dark text-white border-light form-control-lg fs-6" required>
                                            <option value="">Select Rating...</option>
                                            <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
                                            <option value="4">⭐⭐⭐⭐ Good</option>
                                            <option value="3">⭐⭐⭐ Fair</option>
                                            <option value="2">⭐⭐ Poor</option>
                                            <option value="1">⭐ Terrible</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <textarea name="comment" class="form-control bg-dark text-white border-light small" rows="2" placeholder="Leave a comment (optional)"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 py-2">Submit Review</button>
                                </form>
                            </div>
                        }
                    }
                }
                else
                {
                    @if (Model.Item.Claims.Any(c => c.Status == WEBDEV_Project.Models.ClaimStatus.Approved))
                    {
                        <div class="rounded-4 py-4 mb-4" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3);">
                            <i class="fas fa-handshake fa-3x text-primary mb-3"></i>
                            <h5 class="text-primary fw-bold tracking-wider mb-0">PENDING HANDOVER</h5>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-4 py-4 mb-4" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3);">
                            <i class="fas fa-exclamation-circle fa-3x text-warning mb-3"></i>
                            <h5 class="text-warning fw-bold tracking-wider mb-0">CURRENTLY ACTIVE</h5>
                        </div>
                    }

                    @if (Model.IsOwner)
                    {
                        <hr class="border-light opacity-50 mb-4" />
                        <h6 class="text-secondary fw-bold mb-3">Owner Actions</h6>
                        <div class="d-grid gap-3">
                            <a asp-action="Edit" asp-route-id="@Model.Item.Id" class="btn btn-secondary py-2">
                                <i class="fas fa-edit me-2"></i>Edit Item
                            </a>
                            <form asp-action="Resolve" method="post" onsubmit="return confirm('Are you sure this item has been reunited/resolved?');">
                                <input type="hidden" name="id" value="@Model.Item.Id" />
                                <button type="submit" class="btn btn-success w-100 py-2" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                                    <i class="fas fa-check me-2"></i>Mark as Resolved
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to permanently remove this item?');">
                                <input type="hidden" name="id" value="@Model.Item.Id" />
                                <button type="submit" class="btn btn-outline-danger w-100 py-2">
                                    <i class="fas fa-trash-alt me-2"></i>Remove Item
                                </button>
                            </form>
                        </div>
                    }
                    else if (User.Identity!.IsAuthenticated)
                    {
                        if (Model.ClaimsByCurrentUser != null)
                        {
                            <hr class="border-light opacity-50 mb-4" />
                            <h6 class="text-secondary fw-bold mb-3">Your Claim Status</h6>
                            var claim = Model.ClaimsByCurrentUser;
                            var claimColor = claim.Status == WEBDEV_Project.Models.ClaimStatus.Pending ? "warning" : 
                                            claim.Status == WEBDEV_Project.Models.ClaimStatus.Approved ? "success" : "danger";
                                            
                            <div class="alert bg-@claimColor bg-opacity-10 border border-@claimColor border-opacity-25 text-@claimColor text-center mb-4 py-3 rounded-4">
                                <span class="fw-bold d-block mb-1">Status</span>
                                <span class="fs-5 tracking-wider">@claim.Status.ToString().ToUpper()</span>
                            </div>
                            
                            <a asp-controller="Messages" asp-action="Thread" asp-route-claimId="@claim.Id" class="btn btn-secondary w-100 py-2">
                                <i class="fas fa-comments me-2"></i>View Claim Messages
                            </a>
                        }
                        else if (Model.CanClaim)
                        {
                            <hr class="border-light opacity-50 mb-4" />
                            <h6 class="text-secondary fw-bold mb-3">Is this yours? / Do you have it?</h6>
                            <button type="button" class="btn btn-primary w-100 py-3 shadow-lg fs-5" data-bs-toggle="modal" data-bs-target="#claimModal">
                                <i class="fas fa-hand-paper me-2"></i>Submit Claim
                            </button>
                        }
                    }
                    else
                    {
                        <hr class="border-light opacity-50 mb-4" />
                        <div class="bg-dark bg-opacity-25 p-3 rounded-4 border border-light">
                            <p class="text-secondary small mb-0">Please <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none">log in</a> to claim this item or contact the owner.</p>
                        </div>
                    }
                }
            </div>
        </div>

        @if (Model.IsOwner && Model.Item.Claims.Any())
        {
            <div class="glass-panel p-0 overflow-hidden mb-4">
                <div class="bg-dark bg-opacity-50 border-bottom border-light p-3 d-flex align-items-center">
                    <i class="fas fa-inbox me-2 text-primary fs-5"></i> 
                    <span class="fw-bold text-white tracking-wider text-uppercase" style="font-size: 0.85rem;">Claims Received (@Model.Item.Claims.Count)</span>
                </div>
                <ul class="list-group list-group-flush bg-transparent">
                    @foreach (var claim in Model.Item.Claims.OrderByDescending(c => c.CreatedAt))
                    {
                        var statusColor = claim.Status == WEBDEV_Project.Models.ClaimStatus.Pending ? "warning" : claim.Status == WEBDEV_Project.Models.ClaimStatus.Approved ? "success" : "danger";
                        <li class="list-group-item bg-transparent border-bottom border-light p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-white">@claim.Claimant?.DisplayName</strong>
                                <span class="badge bg-@statusColor bg-opacity-25 text-@statusColor border border-@statusColor border-opacity-25">@claim.Status</span>
                            </div>
                            <p class="small text-secondary text-truncate mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; white-space: normal;">@claim.Message</p>
                            <a asp-controller="Messages" asp-action="Thread" asp-route-claimId="@claim.Id" class="btn btn-sm btn-secondary w-100 py-2">Review & Reply</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<!-- Claim Modal -->
@if (Model.CanClaim)
{
    <div class="modal fade" id="claimModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content glass-card p-0">
                <form asp-controller="Claims" asp-action="Submit" method="post">
                    <input type="hidden" name="ItemId" value="@Model.Item.Id" />
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="fas fa-hand-paper me-2"></i>Submit Claim</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info small">
                            Submitting a claim opens a private messaging thread between you and the item poster. Please provide specific details to prove ownership or describe where you found it.
                        </div>
                        <div class="mb-3">
                            <label for="Message" class="form-label fw-bold">Message to Owner</label>
                            <textarea name="Message" id="Message" class="form-control" rows="4" placeholder="Describe specific marks, contents, or passwords to prove it's yours..." required></textarea>
                            <span class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline border-secondary text-white" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Claim</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Flag Modal -->
@if (User.Identity!.IsAuthenticated)
{
    <div class="modal fade" id="flagModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content glass-card p-0">
                <form id="flagForm" onsubmit="submitFlag(event)">
                    <input type="hidden" id="flagItemId" value="@Model.Item.Id" />
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title"><i class="fas fa-flag me-2"></i>Report Item</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Reason for reporting</label>
                            <select id="flagReason" class="form-select" required>
                                <option value="">Select a reason...</option>
                                <option value="Inappropriate Content">Inappropriate Content</option>
                                <option value="Spam / Fake">Spam / Fake</option>
                                <option value="Wrong Category">Wrong Category</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline border-secondary text-white" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Submit Report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('.btn-bookmark').click(function() {
                var btn = $(this);
                var icon = btn.find('i');
                var id = btn.data('id');

                $.post('/Items/Bookmark', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
                    if (res.bookmarked) {
                        icon.removeClass('far').addClass('fas text-primary');
                        btn.addClass('border-primary');
                    } else {
                        icon.removeClass('fas text-primary').addClass('far');
                        btn.removeClass('border-primary');
                    }
                });
            });
        });

        function submitFlag(e) {
            e.preventDefault();
            var id = $('#flagItemId').val();
            var reason = $('#flagReason').val();

            $.post('/Items/Flag', { id: id, reason: reason, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
                $('#flagModal').modal('hide');
                alert('Item reported successfully. Current flags: ' + res.flagCount);
            });
        }
    </script>
}
