@model WEBDEV_Project.ViewModels.ItemListViewModel
@{
    ViewData["Title"] = "Browse Items";
}

<div class="row animate-fade-in-up">
    <!-- Sidebar Filters -->
    <div class="col-md-3 mb-4">
        <div class="glass-panel sticky-top" style="top: 100px; padding: 1.5rem;">
            <div class="border-bottom border-light pb-3 mb-4 d-flex align-items-center">
                <i class="fas fa-filter me-2 text-primary"></i> 
                <span class="fw-bold text-white tracking-wider text-uppercase" style="font-size: 0.85rem;">Filter Items</span>
            </div>
            <div>
                <form method="get" asp-action="Index">
                    <div class="form-group mb-3">
                        <label class="form-label">Search Keywords</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0 border-light bg-transparent text-secondary"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0 border-light" style="background-color: transparent;" name="search" value="@Model.Search" placeholder="What did you lose/find?">
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Type</label>
                        <select name="type" class="form-select border-light text-white">
                            <option value="">All Types</option>
                            <option value="Lost" selected="@(Model.Type == "Lost")">Lost Items</option>
                            <option value="Found" selected="@(Model.Type == "Found")">Found Items</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Category</label>
                        <select name="categoryId" class="form-select border-light text-white">
                            <option value="">All Categories</option>
                            @foreach(var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Building / Location</label>
                        <select name="buildingId" class="form-select border-light text-white">
                            <option value="">Anywhere on Campus</option>
                            @foreach(var bld in Model.Buildings)
                            {
                                <option value="@bld.Id" selected="@(Model.BuildingId == bld.Id)">@bld.Name (@bld.Code)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label">Sort By</label>
                        <select name="sortBy" class="form-select border-light text-white">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                            <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest First</option>
                            <option value="views" selected="@(Model.SortBy == "views")">Most Viewed</option>
                            <option value="claims" selected="@(Model.SortBy == "claims")">Most Claims</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2">Apply Filters</button>
                        <a asp-action="Index" class="btn btn-secondary py-2">Clear All</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-md-9">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 border-bottom border-light pb-3">
            <h2 class="fw-bold mb-0 text-white" style="font-family: var(--font-heading);">Browse Items</h2>
            <span class="text-secondary fw-medium">Showing @Model.Items.Count() of @Model.TotalItems items</span>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="glass-panel text-center py-5 mt-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: rgba(255,255,255,0.05);">
                    <i class="fas fa-search fa-3x text-secondary opacity-50"></i>
                </div>
                <h4 class="text-white fw-bold">No items found matching your criteria.</h4>
                <p class="text-secondary mb-3">Try adjusting your filters or clearing your search.</p>
                <a asp-action="Index" class="btn btn-outline-primary py-2 px-4">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
                @foreach (var item in Model.Items)
                {
                    var badgeClass = item.Type == WEBDEV_Project.Models.ItemType.Lost ? "badge-lost" : "badge-found";
                    <div class="col">
                        <div class="glass-panel interactive h-100 d-flex flex-column overflow-hidden p-0">
                            <div class="position-relative">
                                @if (item.Images.Any(i => i.IsPrimary))
                                {
                                    <img src="@item.Images.First(i => i.IsPrimary).Path" class="w-100" alt="Item Image" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="w-100 d-flex align-items-center justify-content-center" style="height: 200px; background: rgba(3,7,18,0.5);">
                                        <i class="fas fa-image fa-3x text-secondary opacity-50"></i>
                                    </div>
                                }
                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge @badgeClass shadow-sm backdrop-blur">@item.Type.ToString().ToUpper()</span>
                                </div>
                                
                                @if (User.Identity!.IsAuthenticated)
                                {
                                    <button class="btn btn-secondary rounded-circle position-absolute top-0 end-0 m-3 p-0 d-flex align-items-center justify-content-center btn-bookmark border-0 shadow" data-id="@item.Id" style="width: 36px; height: 36px;">
                                        <i class="far fa-bookmark text-white"></i>
                                    </button>
                                }
                            </div>

                            <div class="p-4 flex-grow-1 d-flex flex-column">
                                <h5 class="fw-bold text-white text-truncate mb-2" style="font-family: var(--font-heading);">@item.Title</h5>
                                <div class="d-flex text-secondary small mb-3 gap-3">
                                    <span title="Category" class="badge bg-secondary bg-opacity-25 text-secondary fw-normal border border-secondary border-opacity-25 rounded-pill px-2 py-1"><i class="fas fa-tag me-1"></i> @item.Category?.Name</span>
                                    <span title="Views" class="d-flex align-items-center"><i class="fas fa-eye me-1"></i> @item.ViewCount</span>
                                </div>
                                <p class="text-secondary small text-truncate mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; white-space: normal;">@item.Description</p>
                            </div>
                            
                            <div class="p-3 px-4 border-top border-light bg-dark bg-opacity-25 d-flex justify-content-between align-items-center mt-auto">
                                <small class="text-tertiary fw-medium" title="@item.PostedAt.ToLocalTime().ToString("f")">
                                    <i class="far fa-clock me-1"></i> @item.PostedAt.ToLocalTime().ToString("MMM dd")
                                </small>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-buildingId="@Model.BuildingId" asp-route-type="@Model.Type" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-buildingId="@Model.BuildingId" asp-route-type="@Model.Type" asp-route-sortBy="@Model.SortBy" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-buildingId="@Model.BuildingId" asp-route-type="@Model.Type" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-bookmark').click(function(e) {
                e.preventDefault();
                var btn = $(this);
                var icon = btn.find('i');
                var id = btn.data('id');

                $.post('/Items/Bookmark', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
                    if (res.bookmarked) {
                        icon.removeClass('far').addClass('fas text-primary');
                    } else {
                        icon.removeClass('fas text-primary').addClass('far text-muted');
                    }
                });
            });
        });
    </script>
}
