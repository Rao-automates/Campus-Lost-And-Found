@model WEBDEV_Project.ViewModels.ItemListViewModel
@{
    ViewData["Title"] = "Browse Items";
}

<div class="row">
    <!-- Sidebar Filters -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 sticky-top" style="top: 80px;">
            <div class="card-header bg-white border-bottom fw-bold py-3">
                <i class="fas fa-filter me-2 text-primary"></i> Filter Items
            </div>
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Search Keywords</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0 bg-light" name="search" value="@Model.Search" placeholder="What did you lose/find?">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Type</label>
                        <select name="type" class="form-select bg-light">
                            <option value="">All Types</option>
                            <option value="Lost" selected="@(Model.Type == "Lost")">Lost Items</option>
                            <option value="Found" selected="@(Model.Type == "Found")">Found Items</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Category</label>
                        <select name="categoryId" class="form-select bg-light">
                            <option value="">All Categories</option>
                            @foreach(var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Building / Location</label>
                        <select name="buildingId" class="form-select bg-light">
                            <option value="">Anywhere on Campus</option>
                            @foreach(var bld in Model.Buildings)
                            {
                                <option value="@bld.Id" selected="@(Model.BuildingId == bld.Id)">@bld.Name (@bld.Code)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Sort By</label>
                        <select name="sortBy" class="form-select bg-light">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                            <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest First</option>
                            <option value="views" selected="@(Model.SortBy == "views")">Most Viewed</option>
                            <option value="claims" selected="@(Model.SortBy == "claims")">Most Claims</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-bold">Apply Filters</button>
                        <a asp-action="Index" class="btn btn-light border text-muted">Clear All</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Browse Items</h2>
            <span class="text-muted">Showing @Model.Items.Count() of @Model.TotalItems items</span>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5 text-muted bg-white rounded shadow-sm border">
                <i class="fas fa-search fa-3x mb-3 opacity-50"></i>
                <h5>No items found matching your criteria.</h5>
                <p>Try adjusting your filters or clearing your search.</p>
                <a asp-action="Index" class="btn btn-outline-primary mt-2">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var item in Model.Items)
                {
                    var badgeColor = item.Type == WEBDEV_Project.Models.ItemType.Lost ? "danger" : "success";
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 hover-lift">
                            <div class="position-relative">
                                @if (item.Images.Any(i => i.IsPrimary))
                                {
                                    <img src="@item.Images.First(i => i.IsPrimary).Path" class="card-img-top" alt="Item Image" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                        <i class="fas fa-image fa-3x opacity-50"></i>
                                    </div>
                                }
                                <span class="badge bg-@badgeColor position-absolute top-0 start-0 m-3 fs-6 rounded-pill shadow-sm">@item.Type.ToString().ToUpper()</span>
                                
                                @if (User.Identity!.IsAuthenticated)
                                {
                                    <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-2 shadow-sm text-muted btn-bookmark" data-id="@item.Id" style="width: 40px; height: 40px;">
                                        <i class="far fa-bookmark"></i>
                                    </button>
                                }
                            </div>

                            <div class="card-body">
                                <h5 class="card-title fw-bold pe-2 text-truncate">@item.Title</h5>
                                <div class="d-flex text-muted small mb-3">
                                    <span class="me-3" title="Category"><i class="fas fa-tag me-1"></i> @item.Category?.Name</span>
                                    <span title="Views"><i class="fas fa-eye me-1"></i> @item.ViewCount</span>
                                </div>
                                <p class="card-text text-truncate">@item.Description</p>
                            </div>
                            <div class="card-footer bg-white border-top-0 pt-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted" title="@item.PostedAt.ToLocalTime().ToString("f")">
                                        <i class="far fa-clock me-1"></i> @item.PostedAt.ToLocalTime().ToString("MMM dd")
                                    </small>
                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-buildingId="@Model.BuildingId" asp-route-type="@Model.Type" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-buildingId="@Model.BuildingId" asp-route-type="@Model.Type" asp-route-sortBy="@Model.SortBy" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-buildingId="@Model.BuildingId" asp-route-type="@Model.Type" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-bookmark').click(function(e) {
                e.preventDefault();
                var btn = $(this);
                var icon = btn.find('i');
                var id = btn.data('id');

                $.post('/Items/Bookmark', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
                    if (res.bookmarked) {
                        icon.removeClass('far').addClass('fas text-primary');
                    } else {
                        icon.removeClass('fas text-primary').addClass('far text-muted');
                    }
                });
            });
        });
    </script>
}
