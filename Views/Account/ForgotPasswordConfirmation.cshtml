@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-lg rounded-4 p-5">
            <i class="fas fa-paper-plane fa-4x text-primary mb-4"></i>
            <h3 class="fw-bold mb-3">Check Your Email</h3>
            <p class="text-muted mb-4">
                If the email address you entered is registered with us, you will receive a password reset link shortly.
            </p>
            <p class="small text-muted mb-4">
                Please check your spam or junk folder if you don't see it in your inbox.
            </p>
            <a asp-action="Login" class="btn btn-outline-primary rounded-pill px-5 shadow-sm fw-bold">Return to Login</a>
        </div>
    </div>
</div>
