@model WEBDEV_Project.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center align-items-center mt-5">
    <div class="col-md-5">
        <div class="glass-panel animate-fade-in-up">
            <div class="text-center p-4 pb-0">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-lg" style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));">
                    <i class="fas fa-search-location fa-2x text-white"></i>
                </div>
                <h3 class="fw-bold mb-1 text-white">Welcome Back</h3>
                <p class="text-secondary small">Log in to your Campus Lost & Found account</p>
            </div>
            <div class="p-4 p-md-5 pt-4">
                <form id="account" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small bg-danger bg-opacity-10 p-2 rounded"></div>
                    
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input bg-dark border-secondary" type="checkbox" asp-for="RememberMe" />
                            <label class="form-check-label text-secondary small" asp-for="RememberMe">
                                @Html.DisplayNameFor(m => m.RememberMe)
                            </label>
                        </div>
                        <a id="forgot-password" asp-action="ForgotPassword" class="small text-gradient fw-semibold">Forgot password?</a>
                    </div>
                    
                    <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 fs-5 mb-4">
                        Log in
                    </button>
                </form>
                <div class="text-center text-secondary small">
                    Don't have an account? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-bold text-white text-decoration-none border-bottom border-primary pb-1">Sign up</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
