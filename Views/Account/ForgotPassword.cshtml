@model WEBDEV_Project.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center align-items-center mt-5">
    <div class="col-md-5">
        <div class="glass-panel animate-fade-in-up">
            <div class="text-center p-4 pb-0">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-lg" style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--accent-tertiary), var(--accent-primary));">
                    <i class="fas fa-lock fa-2x text-white"></i>
                </div>
                <h3 class="fw-bold mb-1 text-white">Reset Password</h3>
                <p class="text-secondary small">Enter your email to reset your password</p>
            </div>
            <div class="p-4 p-md-5 pt-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small bg-danger bg-opacity-10 p-2 rounded"></div>
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fs-5 mb-4">
                        Send Reset Link
                    </button>
                </form>
                <div class="text-center text-secondary small">
                    Remember your password? <a asp-action="Login" class="fw-bold text-white text-decoration-none border-bottom border-primary pb-1">Log in</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
