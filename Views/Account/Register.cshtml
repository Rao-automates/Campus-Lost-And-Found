@model WEBDEV_Project.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center align-items-center mt-5">
    <div class="col-md-6">
        <div class="glass-panel animate-fade-in-up">
            <div class="text-center p-4 pb-0">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-lg" style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary));">
                    <i class="fas fa-user-plus fa-2x text-white"></i>
                </div>
                <h3 class="fw-bold mb-1 text-white">Create an Account</h3>
                <p class="text-secondary small">Join Campus Lost & Found to post or claim items</p>
            </div>
            <div class="p-4 p-md-5 pt-4">
                <form id="registerForm" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small bg-danger bg-opacity-10 p-2 rounded"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="DisplayName" class="form-label">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" autocomplete="name" aria-required="true" placeholder="John Doe" />
                        <span asp-validation-for="DisplayName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-2 fs-5 mb-4" style="background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary)); box-shadow: 0 4px 14px 0 rgba(236, 72, 153, 0.39);">
                        Sign up
                    </button>
                </form>
                <div class="text-center text-secondary small">
                    Already have an account? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-bold text-white text-decoration-none border-bottom border-primary pb-1">Log in</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
