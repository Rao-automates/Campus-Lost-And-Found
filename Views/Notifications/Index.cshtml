@model IEnumerable<WEBDEV_Project.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mt-4 mb-5">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold text-primary mb-0"><i class="fas fa-bell me-2"></i>Notifications</h3>
                @if (Model.Any(n => !n.IsRead))
                {
                    <form asp-action="MarkAllRead" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Mark all as read</button>
                    </form>
                }
            </div>
            
            <div class="list-group list-group-flush">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="far fa-bell-slash fa-3x mb-3 opacity-50"></i>
                        <p>You have no notifications.</p>
                    </div>
                }
                else
                {
                    foreach (var n in Model)
                    {
                        <div class="list-group-item p-3 @(n.IsRead ? "bg-white" : "bg-light border-start border-4 border-primary")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1 fw-bold @(n.IsRead ? "text-muted" : "text-dark")">@n.Type</h6>
                                    <p class="mb-1">@n.Message</p>
                                    <small class="text-muted"><i class="far fa-clock me-1"></i> @n.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small>
                                </div>
                                <div class="d-flex flex-column align-items-end">
                                    @if (!string.IsNullOrEmpty(n.Link))
                                    {
                                        <a href="@n.Link" class="btn btn-sm btn-outline-primary rounded-pill mb-2">View</a>
                                    }
                                    @if (!n.IsRead)
                                    {
                                        <button class="btn btn-sm text-muted mark-read-btn" data-id="@n.Id" title="Mark as read">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.mark-read-btn').click(function() {
                var btn = $(this);
                var id = btn.data('id');
                $.post('/Notifications/MarkRead', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function() {
                    btn.closest('.list-group-item').removeClass('bg-light border-start border-4 border-primary').addClass('bg-white');
                    btn.hide();
                    
                    // Update badge logic manually if desired
                });
            });
        });
    </script>
}
